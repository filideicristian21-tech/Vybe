{
  "appId": "it.vybe.app",
  "appName": "Vybe",
  "webDir": "www",
  "server": {
    "url": "https://vybe-pink-pi.vercel.app/?app=ios",
    "allowNavigation": ["vybe-pink-pi.vercel.app"],
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0a10",
    "limitsNavigationsToAppBoundDomains": true,
    "scheme": "Vybe"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
